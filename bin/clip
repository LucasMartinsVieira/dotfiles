#!/usr/bin/env bash

# requires imagemagick to generate thumbnails
# Set CLIP_BACKEND=dms to use `dms clipboard`; defaults to cliphist.

thumbnail_size=64
backend="${CLIP_BACKEND:-cliphist}"
thumbnail_dir="${XDG_CACHE_HOME:-$HOME/.cache}/${backend}/thumbnails"

case "$backend" in
cliphist)
  clipboard_list=$(cliphist list)
  ;;
dms)
  clipboard_list=$(dms clipboard history --json | jq -r '.[] | [.id, .preview] | @tsv')
  ;;
*)
  fuzzel -d --placeholder "clip: unknown backend '$backend'" --lines 0
  exit 1
  ;;
esac

if [ -z "$clipboard_list" ]; then
  fuzzel -d --placeholder "$backend: please store something first" --lines 0
  rm -rf "$thumbnail_dir"
  exit
fi

[ -d "$thumbnail_dir" ] || mkdir -p "$thumbnail_dir"

if [ "$backend" = "cliphist" ]; then
  # Write square shaped thumbnail to cache if it doesn't exist
  read -r -d '' thumbnail <<EOF
/^[0-9]+\s<meta http-equiv=/ { next }
match(\$0, /^([0-9]+)\s(\[\[\s)?binary.*(jpg|jpeg|png|bmp)/, grp) {
  item_id=grp[1]
  ext=grp[3]
  thumbnail_file=item_id"."ext
  system("[ -f ${thumbnail_dir}/"thumbnail_file" ] || echo " item_id "\\\\\t | cliphist decode | magick - -thumbnail ${thumbnail_size}^ -gravity center -extent ${thumbnail_size} ${thumbnail_dir}/"thumbnail_file)
  print \$0"\0icon\x1f${thumbnail_dir}/"thumbnail_file
  next
}
1
EOF
else
  read -r -d '' thumbnail <<EOF
match(\$0, /^([0-9]+)\t\[\[ image .* (jpg|jpeg|png|bmp) /, grp) {
  item_id=grp[1]
  ext=grp[2]
  thumbnail_file=item_id"."ext
  system("[ -f ${thumbnail_dir}/"thumbnail_file" ] || dms clipboard get " item_id " --json | jq -r .data | base64 -d | magick - -thumbnail ${thumbnail_size}^ -gravity center -extent ${thumbnail_size} ${thumbnail_dir}/"thumbnail_file)
  print \$0"\0icon\x1f${thumbnail_dir}/"thumbnail_file
  next
}
1
EOF
fi

item=$(echo "$clipboard_list" | gawk "$thumbnail" | fuzzel -d --placeholder "Search clipboard..." --counter --no-sort --with-nth 2)
exit_code=$?

# ALT+0 to clear history
if [ "$exit_code" -eq 19 ]; then
  confirmation=$(echo -e "No\nYes" | fuzzel -d --placeholder "Delete history?" --lines 2)
  if [ "$confirmation" == "Yes" ]; then
    if [ "$backend" = "cliphist" ]; then
      rm ~/.cache/cliphist/db
    else
      dms clipboard clear
    fi
    rm -rf "$thumbnail_dir"
  fi
# ALT+1 to delete selected item
# configure the keybind with `custom-1` in your fuzzel.ini
elif [ "$exit_code" -eq 10 ]; then
  if [ -n "$item" ]; then
    item_id=$(echo "$item" | cut -f1)
    if [ "$backend" = "cliphist" ]; then
      echo "$item_id" | cliphist delete
    else
      dms clipboard delete "$item_id"
    fi
    find "$thumbnail_dir" -name "${item_id}.*" -delete
  fi
else
  if [ -n "$item" ]; then
    if [ "$backend" = "cliphist" ]; then
      echo "$item" | cliphist decode | wl-copy
    else
      item_id=$(echo "$item" | cut -f1)
      dms clipboard get "$item_id" --copy
    fi
  fi
fi

# Delete cached thumbnails that are no longer in clipboard history
find "$thumbnail_dir" -type f | while IFS= read -r thumbnail_file; do
  item_id=$(basename "${thumbnail_file%.*}")
  if ! grep -q "^${item_id}[[:space:]]" <<<"$clipboard_list"; then
    rm "$thumbnail_file"
  fi
done
